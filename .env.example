# Copy to .env for local development. Never commit .env.

# Where the SQLite database lives. In production this points outside the repo
# (e.g. /home/griljor/health-data/app.db) so redeploys can't touch it.
DB_PATH=./data/app.db

# Used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Free key from https://fdc.nal.usda.gov/api-key-signup.html
# Without it, food search falls back to your saved foods + manual entry only.
USDA_API_KEY=

# API server port. 3000-3007 are taken by griljor on the VPS, and local griljor
# worktrees offset into the 31xx range, so this app sits at 3200.
PORT=3200
